# Copy to .env and fill in.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Random string, 1-256 chars of A-Z a-z 0-9 _ -  (Telegram sends it back in a header)
WEBHOOK_SECRET=change-me-random-string
# Public HTTPS base URL of your server, no trailing slash
WEBHOOK_BASE_URL=https://your-domain.com

DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com
